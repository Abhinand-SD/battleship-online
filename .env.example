# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Secret used to sign auth tokens. REQUIRED in production (>= 16 chars). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30
# Comma-separated browser origins allowed to call the API / open sockets (production).
CORS_ORIGINS=https://your-client.example.com
# Public URL of the client; used to build invite links. Defaults to the requesting origin.
PUBLIC_URL=https://your-client.example.com
# Serve the built client (packages/client/dist) from the API server (single-process deployment).
SERVE_CLIENT=false
CLIENT_DIST=../client/dist
TRUST_PROXY=false
LOG_LEVEL=info

# ---- Database -----------------------------------------------------------
# PostgreSQL connection string. Leave unset to run with the in-memory store (data resets on restart).
DATABASE_URL=postgresql://battleship:battleship@localhost:5432/battleship
# Used by the server test-suite for the Prisma repository tests (optional).
TEST_DATABASE_URL=postgresql://battleship:battleship@localhost:5432/battleship_test

# ---- Game timings (ms) --------------------------------------------------
TURN_TIMEOUT_MS=45000
MAX_CONSECUTIVE_TIMEOUTS=3
RECONNECT_GRACE_MS=60000
PLACEMENT_TIMEOUT_MS=180000
LOBBY_COUNTDOWN_MS=3000
BATTLE_COUNTDOWN_MS=3000
AI_MOVE_DELAY_MS=900

# ---- Rate limiting ------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SOCKET_EVENTS_PER_10S=60
ROOM_JOIN_ATTEMPTS_PER_MIN=15

# ---- Client (Vite, build-time) ------------------------------------------
# Only needed when the client is hosted separately from the API server.
# VITE_SERVER_URL=https://your-api.example.com
